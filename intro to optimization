      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Create 2 arrays of x_values and the corresponding y_values and plot the curve\n",
        "x_values = np.arange(-10, 10.1, 0.1)\n",
        "y_values = loss_func(x_values)\n",
