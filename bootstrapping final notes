    {
      "cell_type": "code",
      "source": [
        "# Step 1 - Decide on the number of times you wish to permute the assignment and\n",
        "# create an array of that size to store the mean differences\n",
        "B = 10000\n",
        "diff_in_means = np.zeros(B)\n",
        "\n",
        "# Step 2 - Create a loop to permute assignments to control and treatment.\n",
        "# Also record the mean difference for each permutation\n",
        "for i in range(B):\n",
        "  new_assignment = np.random.permutation(assignment)\n",
        "  permuted_control_sample_mean = np.mean(outcomes[new_assignment==0])\n",
        "  permuted_treatment_sample_mean = np.mean(outcomes[new_assignment==1])\n",
        "  diff_in_means[i] = permuted_treatment_sample_mean - permuted_control_sample_mean\n",
        "\n",
        "\n",
        "# Step 3 - Plot the histogram of the mean differences\n",
        "fig, ax = plt.subplots()\n",
        "ax.hist(diff_in_means, bins=10)\n",
        "ax.set_xlabel('Diff in permuted means in Hba1c')\n",
        "ax.set_ylabel('Count')\n",
        "plt.show()\n",
        "\n",
        "# Step 4 - Estimate the p-value\n",
        "p_value = np.mean(np.abs(diff_in_means)>=abs(obs_diff_means))\n",
        "print(f\"The p-value is {p_value}.\")\n"
      ],
